rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && userDoc().data.role == 'admin';
    }

    match /username_reservations/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if !exists(/databases/$(database)/documents/username_reservations/$(username))
        && request.resource.data.username == username
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /user_requests/{requestId} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.username is string
        && request.resource.data.name is string
        && request.resource.data.requested_password is string;
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{collectionId}/{docId} {
      allow read: if signedIn()
        && collectionId in [
          'shifts',
          'colaboradores',
          'team_members',
          'holidays',
          'overrides',
          'absences',
          'schedule_snapshots',
          'schedule_logs',
          'api_keys',
          'webhooks'
        ];

      allow write: if isAdmin()
        && collectionId in [
          'shifts',
          'colaboradores',
          'team_members',
          'holidays',
          'overrides',
          'absences',
          'schedule_snapshots',
          'schedule_logs',
          'api_keys',
          'webhooks'
        ];
    }
  }
}
