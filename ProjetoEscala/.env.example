# Copie este arquivo para .env e ajuste os valores se quiser.
# Todas as variáveis aqui são OPCIONAIS — se não definir, o compose usa valores default.

# Porta de acesso à aplicação (padrão: 8080)
PORT=8080

# JWT_SECRET — segredo de assinatura dos tokens. Recomenda-se 32+ caracteres.
# Se deixar em branco, usa o default do docker-compose.
# Gere um forte com: openssl rand -hex 32
JWT_SECRET=

# Credenciais do admin inicial (usadas apenas na PRIMEIRA execução, se não houver admin).
# Defaults: admin / Admin@1234
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Origem permitida para CORS (lista separada por vírgula).
# Deixe em branco para o modo default (nega credentials cross-origin).
# Ex.: CORS_ORIGIN=https://escala.seu-dominio.com
CORS_ORIGIN=
