# Copy this file to .env for local Docker usage.
# In Railway, create these values in the Variables tab.

# Runtime
NODE_ENV=production
TZ=America/Sao_Paulo
PORT=3001

# SQLite database path.
# Local Docker Compose uses /app/data/escala.db.
# Railway should use /data/escala.db with a volume mounted at /data.
DB_PATH=/data/escala.db

# Public frontend build served by Express in production Docker image.
PUBLIC_DIR=/app/public

# JWT secret. Use a long random value in production.
# Example generator: openssl rand -hex 32
JWT_SECRET=

# Initial admin credentials. Used only on first database creation.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# CORS. Leave blank when frontend and backend are served by the same domain.
# Use a comma-separated list only if you split frontend/backend domains.
CORS_ORIGIN=
